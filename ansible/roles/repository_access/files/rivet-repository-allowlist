#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 3 || "$2" != "--manifest" ]] ||
   [[ "$1" != "validate-manifest" && "$1" != "verify" ]]; then
  echo "Usage: rivet-repository-allowlist {validate-manifest|verify} --manifest PATH" >&2
  exit 2
fi

command="$1"
manifest="$3"

if [[ ! -f "$manifest" || -L "$manifest" ]]; then
  echo "Repository allowlist validation failed." >&2
  exit 1
fi

if ! jq -e '
  def nonempty:
    type == "string" and length > 0;

  def valid_date:
    type == "string" and
    test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") and
    ((. + "T00:00:00Z" | fromdateiso8601) | type == "number");

  def exact_keys($required):
    . as $object |
    (($object | keys | length) == ($required | length)) and
    all($required[]; . as $key | $object | has($key));

  . as $manifest |
  (now | strftime("%Y-%m-%d")) as $today |

  ($manifest | type == "object") and
  ($manifest | exact_keys(["schema_version", "repositories"])) and
  ($manifest.schema_version == 1) and
  ($manifest.repositories | type == "array") and
  ($manifest.repositories | length > 0) and

  all($manifest.repositories[];
    . as $repository |

    ($repository | type == "object") and
    ($repository | exact_keys([
      "organization",
      "repository_id",
      "expected_name",
      "default_branch",
      "expected_visibility",
      "required_access",
      "approval_reference",
      "approved_on",
      "expires_on"
    ])) and

    ($repository.organization | nonempty) and
    ($repository.organization | test("^[^/[:space:]]+$")) and
    ($repository.repository_id | type == "number") and
    ($repository.repository_id > 0) and
    (($repository.repository_id | floor) == $repository.repository_id) and
    ($repository.expected_name | nonempty) and
    ($repository.expected_name | test("^[^/[:space:]]+$")) and
    ($repository.default_branch | nonempty) and
    ($repository.expected_visibility |
      ["private", "internal", "public"] | index($repository.expected_visibility) != null) and
    ($repository.required_access |
      ["read", "write"] | index($repository.required_access) != null) and
    ($repository.approval_reference | nonempty) and
    ($repository.approved_on | valid_date) and
    ($repository.expires_on | valid_date) and
    ($repository.approved_on <= $today) and
    ($repository.approved_on <= $repository.expires_on) and
    ($repository.expires_on >= $today)
  ) and

  (
    [.repositories[].repository_id] | length
  ) == (
    [.repositories[].repository_id] | unique | length
  )
' "$manifest" >/dev/null 2>&1; then
  echo "Repository allowlist validation failed." >&2
  exit 1
fi

if [[ "$command" == "validate-manifest" ]]; then
  echo "Repository allowlist is structurally valid."
  exit 0
fi

while IFS= read -r repository; do
  organization="$(jq -r '.organization' <<<"$repository")"
  repository_id="$(jq -r '.repository_id' <<<"$repository")"
  expected_name="$(jq -r '.expected_name' <<<"$repository")"
  default_branch="$(jq -r '.default_branch' <<<"$repository")"
  expected_visibility="$(jq -r '.expected_visibility' <<<"$repository")"
  required_access="$(jq -r '.required_access' <<<"$repository")"

  if ! metadata="$(
    gh api \
      --method GET \
      --header "Accept: application/vnd.github+json" \
      --header "X-GitHub-Api-Version: 2022-11-28" \
      "repos/${organization}/${expected_name}"
  )"; then
    echo "Repository allowlist verification failed." >&2
    exit 1
  fi

  if ! jq -e \
    --argjson repository_id "$repository_id" \
    --arg organization "$organization" \
    --arg expected_name "$expected_name" \
    --arg default_branch "$default_branch" \
    --arg expected_visibility "$expected_visibility" \
    --arg required_access "$required_access" \
    '
      .id == $repository_id and
      .owner.login == $organization and
      .name == $expected_name and
      .default_branch == $default_branch and
      .visibility == $expected_visibility and
      .archived == false and
      .permissions.pull == true and
      (
        $required_access == "read" or
        .permissions.push == true
      )
    ' <<<"$metadata" >/dev/null 2>&1; then
    echo "Repository allowlist verification failed." >&2
    exit 1
  fi
done < <(jq -c '.repositories[]' "$manifest")

echo "Approved repositories verified."
