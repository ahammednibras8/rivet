#!/usr/bin/env bash

set -euo pipefail

repository_manifest=/home/rivet/.config/rivet/repositories.json
allowlist_validator=/usr/local/bin/rivet-repository-allowlist
workspace_root=/home/rivet/workspaces
organization_workspace=/home/rivet/workspaces/organizations
t3_binary=/home/rivet/.local/bin/t3
t3_home=/home/rivet/.t3
t3_database="${t3_home}/userdata/state.sqlite"

cd /
umask 0027

usage() {
  echo "Usage: rivet-repository {verify|clone|status|register}" >&2
  exit 2
}

fail_operation() {
  echo "Repository operation failed." >&2
  exit 1
}

if [[ $# -ne 1 ]]; then
  usage
fi

case "$1" in
  verify)
    exec "$allowlist_validator" verify --manifest "$repository_manifest"
    ;;
  clone)
    if ! "$allowlist_validator" \
      verify \
      --manifest "$repository_manifest" >/dev/null 2>&1; then
      fail_operation
    fi

    repository_count="$(
      jq -r '.repositories | length' "$repository_manifest"
    )"
    [[ "$repository_count" == "1" ]] || fail_operation

    organization="$(
      jq -r '.repositories[0].organization' "$repository_manifest"
    )"
    repository_name="$(
      jq -r '.repositories[0].expected_name' "$repository_manifest"
    )"
    default_branch="$(
      jq -r '.repositories[0].default_branch' "$repository_manifest"
    )"

    organization_directory="${organization_workspace}/${organization}"
    checkout_path="${organization_directory}/${repository_name}"

    if [[ -L "$workspace_root" ||
          -L "$organization_workspace" ||
          -L "$organization_directory" ||
          -e "$checkout_path" ||
          -L "$checkout_path" ]]; then
      fail_operation
    fi

    install -d -m 0750 "$organization_directory"

    staging_directory="$(
      mktemp -d "${organization_directory}/.clone.XXXXXX"
    )"

    cleanup_clone() {
      if [[ -n "${staging_directory:-}" &&
            -d "$staging_directory" &&
            ! -L "$staging_directory" ]]; then
        rm -rf -- "$staging_directory"
      fi
    }

    trap cleanup_clone EXIT

    if ! gh repo clone \
      "${organization}/${repository_name}" \
      "${staging_directory}/checkout" \
      -- \
      --branch "$default_branch" \
      --single-branch \
      >/dev/null 2>&1; then
      fail_operation
    fi

    if ! chmod -R go-w "${staging_directory}/checkout"; then
      fail_operation
    fi

    [[ ! -e "$checkout_path" ]] || fail_operation
    mv -- "${staging_directory}/checkout" "$checkout_path"
    rmdir -- "$staging_directory"
    staging_directory=
    trap - EXIT

    echo "Approved repository cloned."
    ;;
  status)
    if ! "$allowlist_validator" \
      verify \
      --manifest "$repository_manifest" >/dev/null 2>&1; then
      fail_operation
    fi

    repository_count="$(
      jq -r '.repositories | length' "$repository_manifest"
    )"
    [[ "$repository_count" == "1" ]] || fail_operation

    organization="$(
      jq -r '.repositories[0].organization' "$repository_manifest"
    )"
    repository_name="$(
      jq -r '.repositories[0].expected_name' "$repository_manifest"
    )"
    default_branch="$(
      jq -r '.repositories[0].default_branch' "$repository_manifest"
    )"

    organization_directory="${organization_workspace}/${organization}"
    checkout_path="${organization_directory}/${repository_name}"
    expected_remote="https://github.com/${organization}/${repository_name}.git"

    [[ -d "$checkout_path" && ! -L "$checkout_path" ]] ||
      fail_operation

    if ! actual_remote="$(
      git -C "$checkout_path" remote get-url origin 2>/dev/null
    )"; then
      fail_operation
    fi

    if ! actual_branch="$(
      git -C "$checkout_path" symbolic-ref --quiet --short HEAD 2>/dev/null
    )"; then
      fail_operation
    fi

    if ! checkout_status="$(
      git -C "$checkout_path" status --porcelain=v1 \
        --untracked-files=all 2>/dev/null
    )"; then
      fail_operation
    fi

    [[ "$actual_remote" == "$expected_remote" ]] ||
      fail_operation
    [[ "$actual_branch" == "$default_branch" ]] ||
      fail_operation
    [[ -z "$checkout_status" ]] ||
      fail_operation

    current_user="$(id -un)"
    current_group="$(id -gn)"

    if ! find "$checkout_path" \
      -maxdepth 0 \
      -user "$current_user" \
      -group "$current_group" \
      -print |
      grep -Fxq "$checkout_path"; then
      fail_operation
    fi

    if find "$checkout_path" \
      -xdev \
      ! -type l \
      \( -perm -0020 -o -perm -0002 \) \
      -print -quit |
      grep -q .; then
      fail_operation
    fi

    echo "Approved repository checkout is valid."
    ;;
  register)
    if ! "$0" status >/dev/null 2>&1; then
      fail_operation
    fi

    organization="$(
      jq -r '.repositories[0].organization' "$repository_manifest"
    )"
    repository_name="$(
      jq -r '.repositories[0].expected_name' "$repository_manifest"
    )"

    [[ "$organization" =~ ^[A-Za-z0-9-]+$ ]] ||
      fail_operation
    [[ "$repository_name" =~ ^[A-Za-z0-9._-]+$ ]] ||
      fail_operation
    [[ -f "$t3_database" && ! -L "$t3_database" ]] ||
      fail_operation

    checkout_path="${organization_workspace}/${organization}/${repository_name}"

    active_project_count() {
      sqlite3 "$t3_database" <<SQL
SELECT COUNT(*)
FROM projection_projects
WHERE workspace_root = '${checkout_path}'
  AND deleted_at IS NULL;
SQL
    }

    if ! registered_count="$(active_project_count 2>/dev/null)"; then
      fail_operation
    fi

    case "$registered_count" in
      1)
        echo "Approved repository project is registered."
        exit 0
        ;;
      0)
        ;;
      *)
        fail_operation
        ;;
    esac

    if ! HOME=/home/rivet \
      T3CODE_HOME="$t3_home" \
      PATH=/home/rivet/.local/bin:/usr/local/bin:/usr/bin:/bin \
      "$t3_binary" project add \
        "$checkout_path" \
        --title "$repository_name" \
        >/dev/null 2>&1; then
      fail_operation
    fi

    if ! registered_count="$(active_project_count 2>/dev/null)"; then
      fail_operation
    fi

    [[ "$registered_count" == "1" ]] ||
      fail_operation

    echo "Approved repository project is registered."
    ;;
  *)
    usage
    ;;
esac
