#cloud-config

package_update: true

packages:
  - python3
  - python3-apt

users:
  - default
  - name: rivet-admin
    gecos: Rivet administrator
    groups:
      - adm
      - sudo
    lock_passwd: true
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${jsonencode(operator_ssh_public_key)}

ssh_pwauth: false
disable_root: true
