#!/usr/bin/env bash

set -euo pipefail

: "${FAKE_AWS_LOG:?FAKE_AWS_LOG is required}"
printf '%s\n' "$*" >>"$FAKE_AWS_LOG"

if [[ "${1:-}" == "s3api" && "${2:-}" == "put-bucket-policy" ]]; then
  if [[ "$#" != "10" || "$3" != "--bucket" ||
    "$4" != "rivet-tofu-state-123456789012-ap-south-1-an" ||
    "$5" != "--expected-bucket-owner" || "$6" != "123456789012" ||
    "$7" != "--policy" || "$9" != "--region" ||
    "${10}" != "ap-south-1" ]]; then
    printf 'unexpected put-bucket-policy arguments\n' >&2
    exit 64
  fi

  : "${FAKE_POLICY_FILE:?FAKE_POLICY_FILE is required}"
  printf '%s\n' "$8" >"$FAKE_POLICY_FILE"
  [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-policy" ]] || exit 71
  exit 0
fi

case "$*" in
  'sts get-caller-identity --region ap-south-1 --query [Account,Arn] --output text')
    if [[ "${FAKE_AWS_STATUS:-0}" != "0" ]]; then
      printf 'simulated AWS authentication failure\n' >&2
      exit "$FAKE_AWS_STATUS"
    fi

    printf '%b\n' "${FAKE_AWS_IDENTITY:?FAKE_AWS_IDENTITY is required}"
    ;;
  's3api head-bucket --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --region ap-south-1')
    [[ "${FAKE_BUCKET_EXISTS:-false}" == "true" ]]
    ;;
  's3api create-bucket --bucket rivet-tofu-state-123456789012-ap-south-1-an --bucket-namespace account-regional --object-ownership BucketOwnerEnforced --create-bucket-configuration LocationConstraint=ap-south-1 --region ap-south-1')
    if [[ "${FAKE_CREATE_STATUS:-0}" != "0" ]]; then
      printf 'simulated bucket collision\n' >&2
      exit "$FAKE_CREATE_STATUS"
    fi
    ;;
  's3api get-bucket-location --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --region ap-south-1 --query LocationConstraint --output text')
    printf '%s\n' "${FAKE_BUCKET_REGION:-ap-south-1}"
    ;;
  's3api put-bucket-ownership-controls --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --ownership-controls Rules=[{ObjectOwnership=BucketOwnerEnforced}] --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-ownership-controls" ]] || exit 71
    ;;
  's3api put-public-access-block --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-public-access-block" ]] || exit 71
    ;;
  's3api put-bucket-encryption --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --server-side-encryption-configuration Rules=[{ApplyServerSideEncryptionByDefault={SSEAlgorithm=AES256}}] --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-encryption" ]] || exit 71
    ;;
  's3api put-bucket-versioning --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --versioning-configuration Status=Enabled --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-versioning" ]] || exit 71
    ;;
  's3api put-bucket-tagging --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --tagging TagSet=[{Key=ManagedBy,Value=AWSCLI},{Key=Phase,Value=phase-1},{Key=Project,Value=Rivet}] --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-tagging" ]] || exit 71
    ;;
  's3api put-bucket-lifecycle-configuration --bucket rivet-tofu-state-123456789012-ap-south-1-an --expected-bucket-owner 123456789012 --lifecycle-configuration Rules=[{ID=LimitNoncurrentStateAndLockVersions,Status=Enabled,Filter={Prefix=phase-1/},NoncurrentVersionExpiration={NoncurrentDays=90,NewerNoncurrentVersions=10},Expiration={ExpiredObjectDeleteMarker=true}}] --region ap-south-1')
    [[ "${FAKE_FAIL_OPERATION:-}" != "put-bucket-lifecycle-configuration" ]] || exit 71
    ;;
  *)
    printf 'unexpected AWS CLI call: %s\n' "$*" >&2
    exit 64
    ;;
esac
